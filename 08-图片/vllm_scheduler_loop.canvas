{
	"nodes":[
		{"id":"title","type":"text","text":"# Scheduler 与 Continuous Batching\n每个 engine step 重新组 batch","x":80,"y":40,"width":650,"height":105,"color":"1"},
		{"id":"legend","type":"text","text":"## 读图方式\n- 大卡片：队列 / 资源 / 结果\n- 小卡片：调度动作\n- 上排收集状态\n- 下排执行并回写","x":2040,"y":40,"width":430,"height":230,"color":"6"},
