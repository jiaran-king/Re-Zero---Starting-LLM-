    },
    {
      "id": "a",
      "type": "text",
      "text": "## 阶段 0｜main()\n- 读取 PPOConfig\n- deep_post_init\n- ray.init\n- 启动 Runner",
      "x": 80,
      "y": 210,
      "width": 340,
      "height": 260,
      "color": "2"
    },
    {
      "id": "p1",
      "type": "text",
      "text": "◇\n**Runner.run()**\n总装训练系统",
      "x": 455,
      "y": 280,
      "width": 180,
      "height": 120,
      "color": "3"
    },
    {
      "id": "b",
      "type": "text",
      "text": "## 阶段 1｜系统装配\n- tokenizer / processor\n- reward manager\n- train / val dataloader\n- ResourcePoolManager",
      "x": 680,
      "y": 200,
      "width": 390,
      "height": 280,
      "color": "2"
    },
    {
      "id": "p2",
