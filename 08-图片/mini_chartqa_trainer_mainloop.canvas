      "y": 565,
      "width": 180,
      "height": 120,
      "color": "3"
    },
    {
      "id": "d",
      "type": "text",
      "text": "## 阶段 3｜生成链\n- DataProto.from_single_dict\n- pop rollout 输入\n- first rollout\n- get_second_rollout_batch",
